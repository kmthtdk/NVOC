# ---- Server ----
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# ---- Database (MySQL) ----
# Running the backend outside Docker against the compose DB? That container
# publishes on host port 3307 (see root .env DB_PORT), not 3306.
DB_HOST=localhost
DB_PORT=3307
DB_NAME=voc_system
DB_USER=voc_app
DB_PASSWORD=change_me
DB_CONNECTION_LIMIT=10

# ---- Auth ----
# Use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=8h

# ---- Admin bootstrap (RECOMMENDED for production) ----
# When both are set, a real admin is created/updated from these at startup, and
# any seeded demo account still using the default password is disabled (prod only).
# Leave blank in dev to keep using the seeded demo accounts.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Uploads ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# ---- Optional: Gemini AI (forward-looking /ai/triage) ----
GEMINI_API_KEY=
