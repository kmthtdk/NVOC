# ============================================================================
# N-VOC Request System — Docker Compose environment template
# Copy to .env and replace every "change_me" value before `docker compose up`.
#   cp .env.example .env
# Variables marked REQUIRED have no safe default; compose will refuse to start.
# ============================================================================

# ---- Runtime mode ----------------------------------------------------------
NODE_ENV=production

# ---- Database (MySQL 8.4) --------------------------------------------------
# DB_HOST/DB_PORT are fixed to the "db" service inside compose; the values
# below configure credentials + the host port published for local tooling.
MYSQL_ROOT_PASSWORD=change_me_root          # REQUIRED — MySQL root password
DB_NAME=voc_system
DB_USER=voc_app
DB_PASSWORD=change_me_app                    # REQUIRED — app DB user password
DB_PORT=3306                                 # host port -> container 3306
DB_CONNECTION_LIMIT=10

# ---- Backend API -----------------------------------------------------------
API_PORT=4000                                # host port -> container 4000
# Origin(s) allowed by CORS. With the Nginx /api proxy the browser is same-
# origin, but keep this aligned with how you reach the SPA.
CORS_ORIGIN=http://localhost:3000

# ---- Auth ------------------------------------------------------------------
# REQUIRED — must be at least 16 characters (zod-validated at boot).
# Generate one with:  openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_secret_min_16
JWT_EXPIRES_IN=8h

# ---- Admin bootstrap (STRONGLY RECOMMENDED for production) -----------------
# When both are set, the backend creates/updates a real admin from these at
# startup AND (in production) disables any seeded demo account still using the
# default password "Passw0rd!". Leave blank in dev to keep the demo accounts.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Uploads ---------------------------------------------------------------
MAX_UPLOAD_BYTES=10485760                    # 10 MB

# ---- Frontend (build-time; Vite inlines these) -----------------------------
# Leave VITE_API_BASE_URL empty to use the relative "/api" default + Nginx
# reverse proxy. Set an absolute URL only for non-proxied deployments.
VITE_API_BASE_URL=
VITE_APP_NAME=N-VOC Request System
FRONTEND_PORT=3000                           # host port -> container 3000

# ---- Optional: Gemini AI (/ai/triage) --------------------------------------
GEMINI_API_KEY=
